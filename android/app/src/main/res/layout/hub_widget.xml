<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/hub_widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="⚡ Quick Rotation"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tile_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/hub_tile_bg"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⭐" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Favorites" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_collection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/hub_tile_bg"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📚" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Collections" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_random"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/hub_tile_bg"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🎲" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Random" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tile_widget"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/hub_tile_bg"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🧩" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Widget" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_both"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/hub_tile_bg"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✨" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sync Both" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
